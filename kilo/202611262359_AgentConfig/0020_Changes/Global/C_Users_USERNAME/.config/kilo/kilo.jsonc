{
  "$schema": "https://app.kilo.ai/config.json",

  "permission": {
    // 2. Block all external directory access except read-only Go docs
    "external_directory": {
      "*": "ask",
      "F:/Go_Knowledge/**": "allow"
    },


    // 3. Allow reading project files and Go docs; protect secrets & JetBrains metadata
    "read": {
      "*": "allow",
      "F:/Go_Knowledge/**": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "**/.idea/**": "deny",
      ".idea/**": "deny"
    },

    // 4. Allow file edits inside the workspace ONLY (external edits still trigger external_directory: "ask")
    "edit": {
      "*": "allow",
      "F:/Go_Knowledge/**": "deny",
      "**/.idea/**": "deny",
      ".idea/**": "deny"
    },

    // 5. Granular Go & Git command allowlist (prevents repetitive prompts without unrestricted shell access)
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "gofmt *": "allow",
      "go vet *": "allow",
      "go doc *": "allow",
      "go list *": "allow",
      "go test *": "allow",
      "go build -o *": "ask",
      "go build ./..." : "allow",
      "go build .": "allow",
      "go mod tidy": "allow",
      "go mod verify": "allow"
    },

    // 6. Safe local inspection & skill tools
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",

    // 7. Keep network & subagent spawning gated
    "webfetch": "deny",
    "websearch": "deny",
    "task": "ask"
  }
}
